# =========================================================================
# CONFIGURACIÓN DEL AGENTE DE ANÁLISIS DE LOGS
# =========================================================================

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ServiceNow Configuration (opcional)
SERVICENOW_INSTANCE=your_instance.service-now.com
SERVICENOW_CLIENT_ID=your_client_id
SERVICENOW_CLIENT_SECRET=your_client_secret
SERVICENOW_CREATE_INCIDENTS=false

# Logging
LOG_LEVEL=INFO
